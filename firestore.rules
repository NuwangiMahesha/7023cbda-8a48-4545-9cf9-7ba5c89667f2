rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if true;
    }

    // ── transactions ────────────────────────────────────────────────────────
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // ── bets ────────────────────────────────────────────────────────────────
    match /bets/{betId} {
      allow read, write: if true;
    }

    // ── rounds ──────────────────────────────────────────────────────────────
    match /rounds/{roundId} {
      allow read, write: if true;
    }

    // ── settings ────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
